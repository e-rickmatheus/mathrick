---
interface Props {
  id?: string;
  index: string;
  label: string;
  meta?: string;
}
const { id, index, label, meta } = Astro.props;
---

<section id={id} class="relative overflow-x-clip">
  <span aria-hidden="true" data-draw-rule class="absolute inset-x-0 top-0 h-px origin-left bg-line"></span>
  <div class="relative mx-auto max-w-[1280px] border-x border-line">
    <span aria-hidden="true" data-draw-tick class="tick tick-half z-[31] -top-[5px] -left-[6px]"></span>
    <span aria-hidden="true" data-draw-tick class="tick tick-half z-[31] -top-[5px] -right-[5px]"></span>

    <div class="sticky top-12 z-30 border-y border-line bg-bg/60 backdrop-blur-md">
      <div class="flex items-center justify-between gap-4 px-6 py-3 md:px-10">
        <p class="hud-label text-muted">
          <span class="text-faint">{index}</span><span aria-hidden="true" class="mx-2 text-faint">/</span>{label}
        </p>
        {meta && <p class="hud-label hidden text-faint sm:block">{meta}</p>}
      </div>
    </div>

    <slot />
  </div>
</section>
