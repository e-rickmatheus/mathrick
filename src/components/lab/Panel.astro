---
/**
 * Ilustração esquemática (linha fina) no lugar dos vídeos de demonstração.
 * variant 0..6: 0 site · 1 web app · 2 ferramenta · 3 SaaS · 4 hub · 5 dashboard · 6 mobile
 */
interface Props {
  variant: number;
  caption?: string;
}
const { variant, caption } = Astro.props;
const stroke = "var(--line-strong)";
---

<div data-lab-figure class="lab-figure relative aspect-[16/10] w-full overflow-hidden border border-line bg-bg">
  <span aria-hidden="true" class="tick tick-half top-1 left-1"></span>
  <span aria-hidden="true" class="tick tick-half top-1 right-1"></span>
  <span aria-hidden="true" class="tick tick-half bottom-1 left-1"></span>
  <span aria-hidden="true" class="tick tick-half right-1 bottom-1"></span>

  <!-- grade de fundo -->
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-60"
    style="background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:24px 24px;mask-image:radial-gradient(closest-side,black 40%,transparent 100%);-webkit-mask-image:radial-gradient(closest-side,black 40%,transparent 100%)"
  >
  </div>

  <svg viewBox="0 0 320 200" class="absolute inset-0 h-full w-full" fill="none" stroke={stroke} stroke-width="1.25" aria-hidden="true">
    {variant === 0 && (
      <>
        <rect x="60" y="34" width="200" height="132" fill="var(--bg)" />
        <path d="M60 54h200" />
        <circle cx="72" cy="44" r="2.5" /><circle cx="82" cy="44" r="2.5" /><circle cx="92" cy="44" r="2.5" />
        <rect x="76" y="68" width="88" height="10" fill="var(--ink)" stroke="none" opacity=".85" />
        <path d="M76 90h120M76 98h96" />
        <rect class="figure-button" x="76" y="112" width="44" height="14" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".15" />
        <path class="figure-site-cursor" d="m112 132 0 14 4-4 4 7 3-2-4-7h6z" fill="var(--ink)" stroke="var(--bg)" />
        <rect x="188" y="72" width="56" height="78" />
        <path d="M188 120l18-18 14 14 10-8 14 14" />
      </>
    )}
    {variant === 1 && (
      <>
        <rect x="50" y="30" width="220" height="140" fill="var(--bg)" />
        <path d="M50 50h220M96 50v120" />
        <circle cx="62" cy="40" r="2.5" /><circle cx="72" cy="40" r="2.5" /><circle cx="82" cy="40" r="2.5" />
        <path d="M60 66h26M60 80h26M60 94h26M60 108h26" />
        <rect class="figure-nav" x="58" y="62" width="30" height="8" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".2" />
        <rect x="108" y="62" width="70" height="42" />
        <rect x="190" y="62" width="70" height="42" />
        <rect x="108" y="116" width="152" height="42" />
        <path class="figure-chart-line" pathLength="1" d="M118 148l22-18 18 12 24-22 20 14 30-18" stroke="var(--accent)" />
      </>
    )}
    {variant === 2 && (
      <>
        <rect x="54" y="42" width="72" height="72" />
        <circle class="figure-tool-ring" cx="190" cy="78" r="36" stroke-dasharray="48 8 6 8" />
        <path d="M54 142h212M54 156h140" />
        <rect x="214" y="132" width="52" height="30" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".15" />
        <path class="figure-tool-cursor" d="M104 128l0 22 6-5 5 11 5-2-5-11 8 0z" fill="var(--ink)" stroke="none" />
        <path d="M54 30h72M190 30v-6" stroke-dasharray="2 3" />
      </>
    )}
    {variant === 3 && (
      <>
        <rect x="40" y="76" width="56" height="48" fill="var(--bg)" />
        <rect x="132" y="38" width="56" height="48" fill="var(--bg)" />
        <rect x="132" y="114" width="56" height="48" fill="var(--bg)" />
        <rect x="224" y="76" width="56" height="48" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".12" />
        <path d="M96 100l36-38M96 100l36 38M188 62l36 38M188 138l36-38" />
        <path class="figure-flow" d="M96 100l36-38M96 100l36 38M188 62l36 38M188 138l36-38" stroke="var(--ink)" stroke-dasharray="4 48" />
        <path d="M50 92h36M50 100h24M142 54h36M142 130h36M142 138h24" />
        <path d="M236 100h32M236 110h18" stroke="var(--accent)" />
      </>
    )}
    {variant === 4 && (
      <>
        <circle cx="160" cy="100" r="22" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".15" />
        <circle class="figure-orbit" cx="160" cy="100" r="62" stroke-dasharray="2 4" />
        <circle class="figure-hub-pulse" cx="160" cy="100" r="22" stroke="var(--accent)" />
        <path d="M160 78V40M178 88l34-30M182 104h48M176 120l30 34M160 122v38M144 120l-30 34M138 104H90M142 88L108 58" />
        <circle cx="160" cy="34" r="9" fill="var(--bg)" />
        <circle cx="218" cy="52" r="9" fill="var(--bg)" />
        <circle cx="238" cy="104" r="9" fill="var(--bg)" />
        <circle cx="210" cy="160" r="9" fill="var(--bg)" />
        <circle cx="160" cy="166" r="9" fill="var(--bg)" />
        <circle cx="108" cy="160" r="9" fill="var(--bg)" />
        <circle cx="82" cy="104" r="9" fill="var(--bg)" />
        <circle cx="102" cy="52" r="9" fill="var(--bg)" />
      </>
    )}
    {variant === 5 && (
      <>
        <rect x="40" y="30" width="240" height="140" fill="var(--bg)" />
        <rect x="52" y="42" width="64" height="30" />
        <rect x="128" y="42" width="64" height="30" />
        <rect x="204" y="42" width="64" height="30" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".12" />
        <path d="M60 56h26M136 56h26M212 56h26" />
        <path d="M52 156h216M52 86v70" />
        <rect class="figure-bar" x="64" y="132" width="16" height="24" fill="var(--ink)" stroke="none" opacity=".8" />
        <rect class="figure-bar" style="--figure-delay:-.4s" x="88" y="116" width="16" height="40" fill="var(--ink)" stroke="none" opacity=".8" />
        <rect class="figure-bar" style="--figure-delay:-.8s" x="112" y="124" width="16" height="32" fill="var(--ink)" stroke="none" opacity=".8" />
        <rect class="figure-bar" style="--figure-delay:-1.2s" x="136" y="100" width="16" height="56" fill="var(--ink)" stroke="none" opacity=".8" />
        <path class="figure-chart-line" pathLength="1" d="M168 138l28-20 24 10 32-34" stroke="var(--accent)" stroke-width="1.75" />
        <circle cx="252" cy="94" r="3.5" fill="var(--accent)" stroke="none" />
      </>
    )}
    {variant === 6 && (
      <>
        <rect x="116" y="18" width="88" height="164" rx="14" fill="var(--bg)" />
        <path d="M148 28h24" />
        <rect x="128" y="44" width="64" height="30" rx="3" />
        <path d="M136 56h30M136 64h18" />
        <rect class="figure-mobile-tile" x="128" y="82" width="30" height="30" rx="3" stroke="var(--accent)" fill="var(--accent)" fill-opacity=".15" />
        <rect x="162" y="82" width="30" height="30" rx="3" />
        <rect x="128" y="120" width="64" height="18" rx="3" />
        <path d="M128 160h64" />
        <circle cx="140" cy="160" r="0" />
        <circle cx="146" cy="168" r="3" fill="var(--ink)" stroke="none" opacity=".8" />
        <circle cx="160" cy="168" r="3" />
        <circle cx="174" cy="168" r="3" />
        <path class="figure-signal" d="M232 64c12 6 22 20 22 36M242 50c20 10 34 32 34 50" stroke="var(--accent)" stroke-dasharray="2 4" />
        <path class="figure-signal" style="--figure-delay:-1.5s" d="M88 64c-12 6-22 20-22 36M78 50C58 60 44 82 44 100" stroke-dasharray="2 4" />
      </>
    )}
  </svg>


  {caption && <span class="hud-label absolute bottom-2 left-8 text-[10px] text-faint">{caption}</span>}
</div>

<style>
  .figure-site-cursor { animation: site-cursor 6s ease-in-out infinite; }
  .figure-button { animation: button-press 6s ease-in-out infinite; }
  .figure-nav { animation: nav-select 7s ease-in-out infinite; }
  .figure-chart-line { stroke-dasharray: 1; animation: chart-draw 6s ease-in-out infinite; }
  .figure-tool-ring { transform-origin: 190px 78px; animation: orbit 18s linear infinite; }
  .figure-tool-cursor { animation: tool-cursor 7s ease-in-out infinite; }
  .figure-flow { animation: data-flow 4s linear infinite; }
  .figure-orbit { transform-origin: 160px 100px; animation: orbit 40s linear infinite; }
  .figure-hub-pulse { transform-origin: 160px 100px; animation: hub-pulse 4s ease-out infinite; }
  .figure-bar { transform-box: fill-box; transform-origin: center bottom; animation: bar-grow 5s ease-in-out infinite; animation-delay: var(--figure-delay, 0s); }
  .figure-mobile-tile { animation: mobile-select 6s ease-in-out infinite; }
  .figure-signal { animation: signal 3s ease-in-out infinite; animation-delay: var(--figure-delay, 0s); }
  .lab-figure:not(.is-visible) svg :is(path, rect, circle) { animation-play-state: paused; }

  @keyframes site-cursor { 0%, 15%, 85%, 100% { transform: translate(20px, 12px); } 35%, 65% { transform: translate(-12px, -13px); } }
  @keyframes button-press { 0%, 35%, 65%, 100% { fill-opacity: .15; } 45%, 55% { fill-opacity: .5; } }
  @keyframes nav-select { 0%, 15%, 100% { transform: translateY(0); } 35%, 50% { transform: translateY(14px); } 65%, 80% { transform: translateY(28px); } }
  @keyframes chart-draw { 0%, 10% { stroke-dashoffset: 1; opacity: .3; } 55%, 85% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: .3; } }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @keyframes tool-cursor { 0%, 15%, 100% { transform: translate(0, 0); } 40%, 65% { transform: translate(35px, -32px); } }
  @keyframes data-flow { to { stroke-dashoffset: -104; } }
  @keyframes hub-pulse { 0% { transform: scale(1); opacity: .7; } 80%, 100% { transform: scale(2.6); opacity: 0; } }
  @keyframes bar-grow { 0%, 100% { transform: scaleY(.65); } 50% { transform: scaleY(1); } }
  @keyframes mobile-select { 0%, 15%, 100% { transform: translateX(0); fill-opacity: .15; } 45%, 65% { transform: translateX(34px); fill-opacity: .35; } }
  @keyframes signal { 0%, 100% { opacity: .25; stroke-dashoffset: 0; } 50% { opacity: 1; stroke-dashoffset: -12; } }

  @media (prefers-reduced-motion: reduce) {
    .lab-figure svg :is(path, rect, circle) { animation: none; }
  }
</style>

<script>
  const figures = document.querySelectorAll<HTMLElement>("[data-lab-figure]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.target.classList.toggle("is-visible", entry.isIntersecting));
    });
    figures.forEach((figure) => observer.observe(figure));
  } else {
    figures.forEach((figure) => figure.classList.add("is-visible"));
  }
</script>
