---
/** Selo de assinatura do laboratório. Use em cards de projeto, rodapé e onde mais couber. */
interface Props {
  class?: string;
  label?: string;
}
const { class: extra, label = "Assinado · Mathrick Lab" } = Astro.props;
---

<span class:list={["hud-label inline-flex items-center gap-2 border border-line-strong px-2.5 py-1.5 text-[10px] text-muted", extra]}>
  <img src="/mathrick-icon.png" alt="" class="themed-logo h-3.5 w-3.5 object-contain" aria-hidden="true" />
  {label}
</span>
