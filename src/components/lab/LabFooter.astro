---
import { site } from "../../data/lab";
const year = new Date().getFullYear();
const b = site.base;
---

<footer class="relative border-t border-line">
  <div class="relative mx-auto max-w-[1280px] border-x border-line">
    <div class="grid gap-px bg-line md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="bg-bg px-6 py-10 md:px-10">
        <p class="font-display text-2xl font-semibold tracking-[-0.03em] text-ink-strong">
          Mathrick <span class="font-serif font-normal text-muted italic">Lab</span>
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          Laboratório de projetos, soluções e ideias. SaaS, ferramentas, sites, hubs, dashboards e apps, todos assinados pela MATHRICK.
        </p>
      </div>
      <div class="bg-bg px-6 py-10 md:px-8">
        <p class="hud-label mb-4 text-faint">Navegar</p>
        <ul class="space-y-2 text-sm">
          <li><a class="text-muted hover:text-ink" href="/">Home</a></li>
          <li><a class="text-muted hover:text-ink" href={"/#servicos"}>O Lab</a></li>
          <li><a class="text-muted hover:text-ink" href={"/projetos"}>Projetos</a></li>
          <li><a class="text-muted hover:text-ink" href={"/#contato"}>Contato</a></li>
        </ul>
      </div>
      <div class="bg-bg px-6 py-10 md:px-8">
        <p class="hud-label mb-4 text-faint">Redes</p>
        <ul class="space-y-2 text-sm">
          <li><a class="text-muted hover:text-ink" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
          <li><a class="text-muted hover:text-ink" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
          <li><a class="text-muted hover:text-ink" href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></li>
        </ul>
      </div>
      <div class="bg-bg px-6 py-10 md:px-8">
        <p class="hud-label mb-4 text-faint">Contato</p>
        <a class="text-sm text-muted underline decoration-line-strong underline-offset-4 hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="hud-label mt-4 flex items-center gap-2 text-faint">
          <span class="size-1.5 animate-pulse rounded-full bg-emerald-500"></span>Aberto a novos projetos
        </p>
      </div>
    </div>
    <div class="flex flex-col items-start justify-between gap-2 border-t border-line px-6 py-4 sm:flex-row sm:items-center md:px-10">
      <p class="hud-label text-faint">© {year} Erick Matheus · Mathrick Lab</p>
      <p class="hud-label text-faint">Belo Horizonte, MG · Remoto</p>
    </div>
  </div>
</footer>
