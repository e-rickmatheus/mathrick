---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MATHRICK | Laboratório Criativo" description="MATHRICK: Laboratório Criativo — Inovação, desenvolvimento web, design e tecnologia.">
  <!-- Header / Navigation -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-[#09090b]/80 border-b border-zinc-800/80">
    <div class="max-w-6xl mx-auto px-6 h-18 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 via-teal-400 to-cyan-500 p-[1.5px] transition-transform group-hover:scale-105 duration-300">
          <div class="w-full h-full bg-[#09090b] rounded-[10px] flex items-center justify-center font-['Space_Grotesk'] font-black text-emerald-400 text-sm">
            M
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-['Space_Grotesk'] font-bold text-lg tracking-wider text-white">MATHRICK</span>
          <span class="text-[10px] tracking-widest uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20">LAB</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400">
        <a href="#pilares" class="hover:text-emerald-400 transition-colors">Pilares</a>
        <a href="#experimentos" class="hover:text-emerald-400 transition-colors">Experimentos</a>
        <a href="#manifesto" class="hover:text-emerald-400 transition-colors">Manifesto</a>
        <a href="#contato" class="hover:text-emerald-400 transition-colors">Contato</a>
      </nav>

      <div class="flex items-center gap-4">
        <a 
          href="#contato" 
          class="inline-flex items-center justify-center px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider bg-zinc-100 text-zinc-950 hover:bg-emerald-400 transition-all duration-300 shadow-sm hover:shadow-emerald-500/20 hover:shadow-lg"
        >
          Iniciar Conversa
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative pt-20 pb-24 md:pt-32 md:pb-36 overflow-hidden">
      <!-- Glow Gradients -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-emerald-500/15 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="absolute top-1/3 left-1/3 -translate-x-1/2 w-[350px] h-[250px] bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-xs text-zinc-300 mb-8 shadow-inner">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-medium">Laboratório Criativo • Inovação Digital</span>
        </div>

        <h1 class="font-['Space_Grotesk'] text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-white mb-6 leading-[1.1]">
          Onde a imaginação encontra a <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">precisão do código.</span>
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto mb-10 leading-relaxed">
          MATHRICK é um estúdio e laboratório de criação focado em construir interfaces memoráveis, plataformas web de alto rendimento e experiências digitais originais.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#experimentos" 
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm bg-gradient-to-r from-emerald-500 to-teal-500 text-zinc-950 hover:from-emerald-400 hover:to-teal-400 transition-all duration-300 shadow-lg shadow-emerald-500/20"
          >
            Explorar Laboratório
          </a>
          <a 
            href="#manifesto" 
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm bg-zinc-900/90 text-zinc-300 hover:text-white border border-zinc-800 hover:border-zinc-700 transition-all duration-300"
          >
            Conhecer Manifesto
          </a>
        </div>

        <!-- Metrics / Highlights -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-20 pt-12 border-t border-zinc-800/80 max-w-4xl mx-auto">
          <div class="p-4 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
            <div class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-white mb-1">100%</div>
            <div class="text-xs text-zinc-400">Design Autoral</div>
          </div>
          <div class="p-4 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
            <div class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-emerald-400 mb-1">0.1s</div>
            <div class="text-xs text-zinc-400">Performance Otimizada</div>
          </div>
          <div class="p-4 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
            <div class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-teal-400 mb-1">Moderno</div>
            <div class="text-xs text-zinc-400">Stack Tecnológico</div>
          </div>
          <div class="p-4 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
            <div class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-cyan-400 mb-1">Sob Medida</div>
            <div class="text-xs text-zinc-400">Soluções Criativas</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pilares Section -->
    <section id="pilares" class="py-20 md:py-28 bg-zinc-950/60 border-y border-zinc-800/80">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-xl mb-14">
          <span class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Capacidades</span>
          <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl font-bold text-white mt-2">Áreas de Atuação do Lab</h2>
          <p class="text-zinc-400 text-sm mt-3 leading-relaxed">
            Combinamos processos ágeis, sensibilidade estética e as tecnologias mais modernas para transformar necessidades complexas em produtos intuitivos.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-8 rounded-2xl bg-zinc-900/50 border border-zinc-800 hover:border-emerald-500/40 transition-all duration-300 group">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="font-['Space_Grotesk'] text-xl font-bold text-white mb-2">Desenvolvimento Web</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Sites institucionais, landing pages de alta conversão, portfólios interativos e web apps construídos com frameworks ultrarrápidos e seguros.
            </p>
          </div>

          <div class="p-8 rounded-2xl bg-zinc-900/50 border border-zinc-800 hover:border-teal-500/40 transition-all duration-300 group">
            <div class="w-12 h-12 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <h3 class="font-['Space_Grotesk'] text-xl font-bold text-white mb-2">UI/UX & Design System</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Arquitetura de informação, interfaces elegantes e consistentes focadas na melhor experiência do usuário em qualquer tamanho de tela.
            </p>
          </div>

          <div class="p-8 rounded-2xl bg-zinc-900/50 border border-zinc-800 hover:border-cyan-500/40 transition-all duration-300 group">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="font-['Space_Grotesk'] text-xl font-bold text-white mb-2">Prototipagem & Inovação</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Validação acelerada de hipóteses, micro-interações dinâmicas, inteligência artificial aplicada e experimentação de novas mídias.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Experimentos Section -->
    <section id="experimentos" class="py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-4">
          <div>
            <span class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Showcase</span>
            <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl font-bold text-white mt-2">Laboratório de Ideias</h2>
          </div>
          <p class="text-zinc-400 text-sm max-w-md">
            Espaço dedicado para protótipos, projetos em produção e experimentações artísticas e tecnológicas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Card 1 -->
          <div class="group relative rounded-2xl bg-zinc-900/40 border border-zinc-800 p-8 hover:border-zinc-700 transition-all duration-300 overflow-hidden">
            <div class="absolute -right-12 -top-12 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/20 transition-all duration-500"></div>
            <div class="flex items-center justify-between text-xs text-zinc-400 mb-6">
              <span class="px-2.5 py-1 rounded-md bg-zinc-800 font-medium text-emerald-400">Em Desenvolvimento</span>
              <span>2026</span>
            </div>
            <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
              Plataforma MATHRICK Core
            </h3>
            <p class="text-zinc-400 text-sm leading-relaxed mb-6">
              O ecossistema digital central que reúne os módulos de serviços criativos, blog técnico, experimentos interativos e contato direto.
            </p>
            <div class="flex flex-wrap gap-2 text-xs font-mono text-zinc-400">
              <span class="px-2 py-1 rounded bg-zinc-800/80 border border-zinc-700/50">#Astro</span>
              <span class="px-2 py-1 rounded bg-zinc-800/80 border border-zinc-700/50">#TailwindCSS</span>
              <span class="px-2 py-1 rounded bg-zinc-800/80 border border-zinc-700/50">#Vercel</span>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="group relative rounded-2xl bg-zinc-900/40 border border-zinc-800 p-8 hover:border-zinc-700 transition-all duration-300 overflow-hidden">
            <div class="absolute -right-12 -top-12 w-48 h-48 bg-teal-500/10 rounded-full blur-3xl group-hover:bg-teal-500/20 transition-all duration-500"></div>
            <div class="flex items-center justify-between text-xs text-zinc-400 mb-6">
              <span class="px-2.5 py-1 rounded-md bg-zinc-800 font-medium text-teal-400">Pesquisa & Lab</span>
              <span>2026</span>
            </div>
            <h3 class="font-['Space_Grotesk'] text-2xl font-bold text-white mb-3 group-hover:text-teal-300 transition-colors">
              Design Generativo & Micro-Interações
            </h3>
            <p class="text-zinc-400 text-sm leading-relaxed mb-6">
              Coleção de componentes visuais reativos, shaders e experiências gráficas para web que elevam a retenção e o engajamento.
            </p>
            <div class="flex flex-wrap gap-2 text-xs font-mono text-zinc-400">
              <span class="px-2 py-1 rounded bg-zinc-800/80 border border-zinc-700/50">#CreativeCoding</span>
              <span class="px-2 py-1 rounded bg-zinc-800/80 border border-zinc-700/50">#Canvas</span>
              <span class="px-2 py-1 rounded bg-zinc-800/80 border border-zinc-700/50">#UI_UX</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Manifesto Section -->
    <section id="manifesto" class="py-20 md:py-28 bg-zinc-950/40 border-t border-zinc-800/80">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <span class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Nosso Propósito</span>
        <h2 class="font-['Space_Grotesk'] text-3xl sm:text-4xl font-bold text-white mt-3 mb-6">
          Por que um Laboratório Criativo?
        </h2>
        <p class="text-base sm:text-lg text-zinc-300 leading-relaxed mb-6">
          Acreditamos que a internet merece mais do que templates genéricos e fórmulas prontas. Cada marca, produto ou ideia tem uma identidade própria que deve ser traduzida em código autêntico, interfaces fluidas e uma presença digital marcante.
        </p>
        <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl mx-auto">
          No <strong class="text-white">MATHRICK-LAB</strong>, cada linha de código é pensada para harmonizar velocidade extrema, design arrojado e usabilidade sem atritos.
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="contato" class="py-20 md:py-28 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-emerald-950/10 to-transparent pointer-events-none"></div>
      <div class="max-w-3xl mx-auto px-6 relative z-10 text-center">
        <h2 class="font-['Space_Grotesk'] text-3xl sm:text-5xl font-bold text-white mb-6">
          Vamos construir algo extraordinário juntos?
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base mb-10 max-w-xl mx-auto">
          Tem um novo projeto, ideia ou desafio para o laboratório? Entre em contato e vamos conversar sobre a sua visão.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="mailto:contato@mathrick.com" 
            class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-sm bg-white text-zinc-950 hover:bg-emerald-400 transition-all duration-300 shadow-xl"
          >
            Fale com o MATHRICK
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-zinc-800/80 bg-[#09090b] py-12">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-zinc-500">
      <div class="flex items-center gap-3">
        <span class="font-['Space_Grotesk'] font-bold text-zinc-300 text-sm">MATHRICK-LAB</span>
        <span>—</span>
        <span>Laboratório Criativo</span>
      </div>
      <div>
        <span>&copy; {new Date().getFullYear()} MATHRICK. Todos os direitos reservados.</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://github.com" target="_blank" rel="noreferrer" class="hover:text-zinc-300 transition-colors">GitHub</a>
        <a href="#pilares" class="hover:text-zinc-300 transition-colors">Pilares</a>
        <a href="#contato" class="hover:text-zinc-300 transition-colors">Contato</a>
      </div>
    </div>
  </footer>
</Layout>
