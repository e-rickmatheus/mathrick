---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MATHRICK — Laboratório Criativo & Design de Alta Conversão" description="Design de produto, websites de alta conversão e engenharia criativa para marcas e produtos digitais que desejam liderar.">
  <!-- Floating Glass Navbar -->
  <header class="fixed top-4 left-0 right-0 z-50 px-4 pointer-events-none">
    <div class="max-w-4xl mx-auto backdrop-blur-xl bg-[#09090f]/75 border border-white/10 rounded-full px-5 py-2.5 flex items-center justify-between pointer-events-auto shadow-2xl shadow-black/80">
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="w-7 h-7 rounded-full bg-white/10 border border-white/20 flex items-center justify-center font-['Plus_Jakarta_Sans'] font-black text-white text-xs group-hover:scale-105 transition-transform">
          M
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-['Plus_Jakarta_Sans'] font-bold text-sm tracking-tight text-white">MATHRICK</span>
          <span class="text-[10px] text-zinc-400 font-medium hidden sm:inline">LAB</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-zinc-400">
        <a href="#trabalhos" class="hover:text-white transition-colors">Trabalhos</a>
        <a href="#servicos" class="hover:text-white transition-colors">Serviços</a>
        <a href="#sobre" class="hover:text-white transition-colors">Sobre</a>
        <a href="#contato" class="hover:text-white transition-colors">Contato</a>
      </nav>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 text-[11px] text-zinc-400 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.06]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Disponível para projetos</span>
        </div>
        <a 
          href="#contato" 
          class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-black hover:bg-zinc-200 transition-all duration-200"
        >
          Conversar
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow pt-28">
    <!-- Hero Section -->
    <section class="relative pt-12 pb-24 md:pt-20 md:pb-32 overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-white/[0.03] blur-[140px] rounded-full pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-[11px] text-zinc-300 mb-8 font-medium tracking-wide uppercase">
          <span>Estratégia</span>
          <span class="text-zinc-600">•</span>
          <span>Design de Produto</span>
          <span class="text-zinc-600">•</span>
          <span>Alta Conversão</span>
        </div>

        <!-- Headline -->
        <h1 class="font-['Plus_Jakarta_Sans'] text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-[-0.03em] text-white leading-[1.05] mb-8">
          Construindo produtos digitais que movem marcas adiante.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed mb-10">
          Laboratório de design, interfaces de alta performance e experiências imersivas. Transformamos ideias complexas em produtos digitais claros, utilizáveis e altamente memoráveis.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a 
            href="#contato" 
            class="w-full sm:w-auto px-7 py-3 rounded-full font-medium text-sm bg-white text-black hover:bg-zinc-200 transition-all duration-200 shadow-xl shadow-white/5"
          >
            Iniciar um Projeto
          </a>
          <a 
            href="#trabalhos" 
            class="w-full sm:w-auto px-7 py-3 rounded-full font-medium text-sm bg-white/[0.05] text-zinc-200 hover:text-white border border-white/10 hover:border-white/20 transition-all duration-200"
          >
            Explorar Trabalhos
          </a>
        </div>
      </div>
    </section>

    <!-- Tech & Capabilities Ticker -->
    <section class="border-y border-white/[0.08] bg-white/[0.01] py-5 overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
        <span class="text-[11px] uppercase tracking-widest text-zinc-400 font-semibold shrink-0">Stack & Capacidades:</span>
        <div class="flex flex-wrap items-center justify-center gap-6 font-mono text-[11px] text-zinc-400">
          <span class="hover:text-white transition-colors">Figma</span>
          <span class="text-zinc-700">/</span>
          <span class="hover:text-white transition-colors">Astro</span>
          <span class="text-zinc-700">/</span>
          <span class="hover:text-white transition-colors">Tailwind CSS</span>
          <span class="text-zinc-700">/</span>
          <span class="hover:text-white transition-colors">React & Next.js</span>
          <span class="text-zinc-700">/</span>
          <span class="hover:text-white transition-colors">UI/UX Systems</span>
          <span class="text-zinc-700">/</span>
          <span class="hover:text-white transition-colors">Alta Conversão</span>
          <span class="text-zinc-700">/</span>
          <span class="hover:text-white transition-colors">Vercel</span>
        </div>
      </div>
    </section>

    <!-- Selected Works / Trabalhos Selecionados -->
    <section id="trabalhos" class="py-24 md:py-32">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-6">
          <div>
            <span class="text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-400">Portfólio & Casos</span>
            <h2 class="font-['Plus_Jakarta_Sans'] text-3xl sm:text-4xl font-bold tracking-tight text-white mt-2">
              Projetos Selecionados
            </h2>
          </div>
          <p class="text-sm text-zinc-400 max-w-sm">
            Criações de ponta a ponta focadas em escala, usabilidade apurada e identidade marcante.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Project 1 -->
          <div class="group rounded-3xl bg-[#090912]/80 border border-white/10 p-7 hover:border-white/25 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-full h-56 rounded-2xl bg-gradient-to-br from-zinc-900 to-zinc-950 border border-white/[0.08] mb-6 overflow-hidden relative flex items-center justify-center p-6 group-hover:border-white/20 transition-all">
                <!-- Abstract UI mockup -->
                <div class="w-full h-full rounded-xl bg-black/60 border border-white/10 p-4 flex flex-col justify-between shadow-2xl">
                  <div class="flex items-center justify-between border-b border-white/10 pb-3">
                    <div class="flex items-center gap-2">
                      <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                      <span class="text-[10px] font-mono text-zinc-400">MATHRICK CORE // V.1</span>
                    </div>
                    <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-white/10 text-zinc-300">ESTÁVEL</span>
                  </div>
                  <div class="space-y-2">
                    <div class="h-3 w-3/4 rounded bg-white/20"></div>
                    <div class="h-2 w-1/2 rounded bg-white/10"></div>
                  </div>
                  <div class="grid grid-cols-3 gap-2 pt-2">
                    <div class="h-10 rounded-lg bg-white/[0.04] border border-white/5"></div>
                    <div class="h-10 rounded-lg bg-white/[0.04] border border-white/5"></div>
                    <div class="h-10 rounded-lg bg-white/[0.04] border border-white/5"></div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs font-mono text-zinc-400 mb-2">
                <span>WEBSITE & ECOSSISTEMA</span>
                <span>•</span>
                <span>2026</span>
              </div>
              <h3 class="font-['Plus_Jakarta_Sans'] text-2xl font-bold text-white mb-3 group-hover:text-zinc-200 transition-colors">
                Plataforma MATHRICK Core
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-6">
                Ecossistema digital desenvolvido para o laboratório, com velocidade de carregamento instantânea, zero dependências pesadas e arquitetura pronta para expansão.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 text-[11px] font-mono text-zinc-400 pt-4 border-t border-white/[0.06]">
              <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Astro 5</span>
              <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Tailwind v4</span>
              <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Vercel Edge</span>
            </div>
          </div>

          <!-- Project 2 -->
          <div class="group rounded-3xl bg-[#090912]/80 border border-white/10 p-7 hover:border-white/25 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-full h-56 rounded-2xl bg-gradient-to-br from-zinc-900 to-zinc-950 border border-white/[0.08] mb-6 overflow-hidden relative flex items-center justify-center p-6 group-hover:border-white/20 transition-all">
                <!-- Abstract UI mockup -->
                <div class="w-full h-full rounded-xl bg-black/60 border border-white/10 p-4 flex flex-col justify-between shadow-2xl">
                  <div class="flex items-center justify-between border-b border-white/10 pb-3">
                    <span class="text-[10px] font-mono text-zinc-400">CONVERSION LAB</span>
                    <span class="text-[10px] font-mono text-emerald-400">+100% CONVERSÃO</span>
                  </div>
                  <div class="flex items-center justify-center py-4">
                    <div class="w-24 h-12 rounded-xl bg-gradient-to-r from-white/10 to-white/5 border border-white/20 flex items-center justify-center text-xs font-semibold text-white">
                      Action Funnel
                    </div>
                  </div>
                  <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
                    <div class="h-full w-4/5 bg-emerald-400 rounded-full"></div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs font-mono text-zinc-400 mb-2">
                <span>LANDING PAGE & FUNIL</span>
                <span>•</span>
                <span>DESIGN SYSTEM</span>
              </div>
              <h3 class="font-['Plus_Jakarta_Sans'] text-2xl font-bold text-white mb-3 group-hover:text-zinc-200 transition-colors">
                Landing Pages de Alta Conversão
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-6">
                Estruturas de apresentação desenhadas para produtos digitais e infoprodutos com foco obsessivo em tempo de carregamento, hierarquia visual e taxa de resposta.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 text-[11px] font-mono text-zinc-400 pt-4 border-t border-white/[0.06]">
              <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">UI / UX</span>
              <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">Storytelling</span>
              <span class="px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08]">CRO</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services / Do Conceito ao Lançamento -->
    <section id="servicos" class="py-24 bg-white/[0.015] border-y border-white/[0.08]">
      <div class="max-w-5xl mx-auto px-6">
        <div class="max-w-xl mb-16">
          <span class="text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-400">Especialidades</span>
          <h2 class="font-['Plus_Jakarta_Sans'] text-3xl sm:text-4xl font-bold tracking-tight text-white mt-2">
            Do conceito ao lançamento.
          </h2>
          <p class="text-sm text-zinc-400 mt-3 leading-relaxed">
            Soluções completas unindo estratégia, rigor tipográfico e desenvolvimento limpo para quem busca se destacar no mercado.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-8 rounded-3xl bg-[#090912]/60 border border-white/10 hover:border-white/20 transition-all">
            <div class="text-xs font-mono text-zinc-400 mb-6 font-semibold">01 / WEBSITES</div>
            <h3 class="font-['Plus_Jakarta_Sans'] text-xl font-bold text-white mb-3">
              Websites & Landing Pages
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Criação de páginas institucionais e páginas de vendas imersivas que contam histórias fortes e convertem visitantes em clientes fiéis.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#090912]/60 border border-white/10 hover:border-white/20 transition-all">
            <div class="text-xs font-mono text-zinc-400 mb-6 font-semibold">02 / INTERFACES</div>
            <h3 class="font-['Plus_Jakarta_Sans'] text-xl font-bold text-white mb-3">
              Design de Produto & UX/UI
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Estruturação de design systems consistentes, prototipagem navegável de alta fidelidade e arquitetura de interfaces intuitivas.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#090912]/60 border border-white/10 hover:border-white/20 transition-all">
            <div class="text-xs font-mono text-zinc-400 mb-6 font-semibold">03 / ENGENHARIA</div>
            <h3 class="font-['Plus_Jakarta_Sans'] text-xl font-bold text-white mb-3">
              Engenharia Front-end & Lab
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Implementação ágil com frameworks modernos, animações leves, compatibilidade multi-dispositivos e deploy automatizado na nuvem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="sobre" class="py-24 md:py-32">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
          <div class="md:col-span-5">
            <span class="text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-400">Sobre o MATHRICK</span>
            <h2 class="font-['Plus_Jakarta_Sans'] text-3xl sm:text-4xl font-bold tracking-tight text-white mt-2 mb-6">
              Design que gera clareza e resultados.
            </h2>
            <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="text-zinc-400">Localização</span>
                <span class="text-zinc-200 font-medium">Brasil / Remoto Global</span>
              </div>
              <div class="flex items-center justify-between text-xs">
                <span class="text-zinc-400">Foco</span>
                <span class="text-zinc-200 font-medium">Web, Apps & Identidade</span>
              </div>
              <div class="flex items-center justify-between text-xs">
                <span class="text-zinc-400">Disponibilidade</span>
                <span class="text-emerald-400 font-medium">Aceitando Projetos</span>
              </div>
            </div>
          </div>

          <div class="md:col-span-7 space-y-6 text-zinc-400 text-sm sm:text-base leading-relaxed">
            <p>
              O <strong class="text-white font-medium">MATHRICK: Laboratório Criativo</strong> foi concebido para entregar o melhor do design digital com o rigor da engenharia moderna. Acreditamos que marcas relevantes não se conformam com soluções genéricas.
            </p>
            <p>
              Com foco total na experiência do usuário, construímos cada detalhe com precisão milimétrica: desde a tipografia e o espaçamento harmônico até o tempo de resposta e as micro-interações que encantam o usuário final.
            </p>
            <p>
              Seja para estruturar o novo produto da sua empresa, redesenhar sua presença digital ou criar uma landing page com alta performance comercial, estamos prontos para transformar sua visão em realidade.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section / Form Card -->
    <section id="contato" class="py-24 bg-white/[0.015] border-t border-white/[0.08] relative">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center max-w-xl mx-auto mb-14">
          <span class="text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-400">Contato Direto</span>
          <h2 class="font-['Plus_Jakarta_Sans'] text-3xl sm:text-5xl font-bold tracking-tight text-white mt-2 mb-4">
            Vamos construir algo extraordinário?
          </h2>
          <p class="text-sm text-zinc-400">
            Conte-nos um pouco sobre a sua ideia, desafio ou prazo. Responderemos rapidamente.
          </p>
        </div>

        <div class="max-w-xl mx-auto rounded-3xl bg-[#090912]/90 border border-white/10 p-8 sm:p-10 shadow-2xl backdrop-blur-xl">
          <form 
            action="mailto:erickmrdm@gmail.com" 
            method="GET" 
            class="space-y-5"
          >
            <div>
              <label class="block text-xs font-medium text-zinc-300 mb-2">Seu Nome</label>
              <input 
                type="text" 
                name="subject"
                placeholder="Como prefere ser chamado?" 
                class="w-full px-4 py-3 rounded-xl bg-white/[0.05] border border-white/10 text-white placeholder-zinc-400 text-sm focus:outline-none focus:border-white/40 transition-colors"
                required
              />
            </div>

            <div>
              <label class="block text-xs font-medium text-zinc-300 mb-2">Seu E-mail ou WhatsApp</label>
              <input 
                type="text" 
                placeholder="exemplo@email.com ou (11) 99999-9999" 
                class="w-full px-4 py-3 rounded-xl bg-white/[0.05] border border-white/10 text-white placeholder-zinc-400 text-sm focus:outline-none focus:border-white/40 transition-colors"
                required
              />
            </div>

            <div>
              <label class="block text-xs font-medium text-zinc-300 mb-2">Detalhes do Projeto</label>
              <textarea 
                name="body"
                rows="4" 
                placeholder="Qual é a sua ideia, objetivo ou prazo estimado?" 
                class="w-full px-4 py-3 rounded-xl bg-white/[0.05] border border-white/10 text-white placeholder-zinc-400 text-sm focus:outline-none focus:border-white/40 transition-colors resize-none"
                required
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-3.5 rounded-xl font-medium text-sm bg-white text-black hover:bg-zinc-200 transition-all duration-200 shadow-lg cursor-pointer"
            >
              Enviar Mensagem
            </button>
          </form>

          <div class="mt-8 pt-6 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
            <span>Prefere conversar diretamente?</span>
            <a 
              href="mailto:erickmrdm@gmail.com" 
              class="text-zinc-200 hover:text-white font-medium underline underline-offset-4"
            >
              erickmrdm@gmail.com
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/[0.08] bg-[#000005] py-12">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-zinc-400">
      <div class="flex items-center gap-2 font-medium text-zinc-300">
        <span>MATHRICK</span>
        <span>•</span>
        <span>Laboratório Criativo</span>
      </div>
      <div>
        <span>&copy; {new Date().getFullYear()} MATHRICK. Todos os direitos reservados.</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://github.com/e-rickmatheus/mathrick" target="_blank" rel="noreferrer" class="hover:text-white transition-colors">GitHub</a>
        <a href="#trabalhos" class="hover:text-white transition-colors">Trabalhos</a>
        <a href="#contato" class="hover:text-white transition-colors">Contato</a>
      </div>
    </div>
  </footer>
</Layout>
