---
import LabLayout from "../layouts/LabLayout.astro";
import Section from "../components/lab/Section.astro";
import Btn from "../components/lab/Btn.astro";
import Panel from "../components/lab/Panel.astro";
import HeroField from "../components/lab/HeroField.astro";
import Signature from "../components/lab/Signature.astro";
import { site, ticker, capabilities, signature, stages, projects } from "../data/lab";

const wordmark = "MATHRICK".split("");
const featured = projects.slice(0, 3);
const b = site.base;
---

<LabLayout
  current="home"
  path="/"
  title="MATHRICK LAB — Projetos, soluções e ideias"
  description="Laboratório de projetos, soluções e ideias: SaaS, ferramentas pessoais, sites personalizados, hubs, dashboards, web apps e apps mobile, todos assinados pela MATHRICK."
>
  <!-- ================= HERO ================= -->
  <section id="hero" class="relative overflow-hidden">
    <div class="relative flex min-h-[calc(100svh-3rem)] flex-col">
      <div aria-hidden="true" class="absolute inset-0"><HeroField /></div>

      <div class="pointer-events-none relative z-40 mx-auto flex w-full max-w-[1280px] flex-1 flex-col items-center justify-center px-6 py-10 md:px-10">
        <div class="relative flex w-full max-w-5xl flex-col items-center text-center">
          <!-- halo que apaga a grade atrás do texto -->
          <div
            aria-hidden="true"
            class="absolute"
            style="inset:-88px -64px;background:radial-gradient(closest-side, color-mix(in srgb, var(--bg) 78%, transparent), transparent)"
          >
          </div>

          <!-- Wordmark gigante, letra por letra -->
          <div class="pointer-events-none relative z-40 w-full" style="container-type:inline-size">
            <div
              aria-hidden="true"
              class="absolute -inset-x-[4%] -inset-y-[30%]"
              style="backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);mask-image:radial-gradient(closest-side, black 45%, transparent 100%);-webkit-mask-image:radial-gradient(closest-side, black 45%, transparent 100%)"
            >
            </div>
            <div
              role="img"
              aria-label="MATHRICK"
              class="relative flex justify-center text-ink-strong whitespace-nowrap"
              style="font-family:var(--font-display);font-weight:750;font-stretch:125%;font-size:13.4cqw;line-height:1;letter-spacing:-0.01em"
            >
              {wordmark.map((l) => (
                <span
                  aria-hidden="true"
                  class="wm-letter inline-block text-center"
                  style="will-change:transform, opacity;text-shadow:0 0 0.6vw color-mix(in srgb, var(--bg) 92%, transparent), 0 0.25vw 2.4vw color-mix(in srgb, var(--bg) 78%, transparent), 0 0.4vw 5vw color-mix(in srgb, var(--bg) 55%, transparent)"
                >{l}</span>
              ))}
            </div>
            <p class="hud-label relative mt-3 text-faint" data-reveal>— Laboratório —</p>
          </div>

          <h1 data-reveal class="relative mt-8 font-display text-3xl leading-[1.05] font-medium tracking-[-0.03em] text-ink-strong sm:text-4xl">
            Projetos, soluções <span class="font-serif font-normal text-muted italic">e ideias.</span>
          </h1>
          <p data-reveal class="relative mt-4 max-w-md text-lg leading-relaxed text-muted">
            Onde nascem ferramentas, sites, hubs, dashboards e apps. Cada um assinado pela MATHRICK.
          </p>

          <div data-reveal class="pointer-events-auto relative mt-7 flex flex-wrap items-center justify-center gap-3">
            <Btn href="/projetos">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              Ver o laboratório
            </Btn>
            <Btn href={site.whatsappMsg} external variant="outline">Propor uma ideia</Btn>
          </div>

          <div data-reveal class="pointer-events-auto relative mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="hud-label flex items-center gap-1.5 text-faint hover:text-ink">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
              GitHub
            </a>
            <p class="hud-label text-faint">SaaS · Web · Mobile</p>
            <p class="hud-label text-faint">Assinado Mathrick</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <div class="marquee border-t border-line" aria-label="Especialidades">
    {[0, 1].map((n) => (
      <ul class="marquee-track items-center" aria-hidden={n === 1 ? "true" : undefined}>
        {ticker.map((t) => (
          <li class="hud-label flex items-center px-6 py-3 whitespace-nowrap text-muted">
            <span aria-hidden="true" class="mr-6 text-accent-ink">◆</span>{t}
          </li>
        ))}
      </ul>
    ))}
  </div>

  <!-- ================= 01 O QUE O LAB PRODUZ ================= -->
  <Section id="servicos" index="01" label="O que sai do lab" meta="Sete frentes · Um selo">
    <div class="px-6 py-14 md:px-10 md:py-20">
      <p data-reveal class="hud-label text-faint">Ferramentas · Sites · Apps</p>
      <h2 data-reveal class="mt-4 max-w-3xl font-display text-4xl leading-[1.02] font-medium tracking-[-0.035em] text-ink-strong sm:text-5xl md:text-6xl">
        Se resolve um problema, <span class="font-serif font-normal text-muted italic">cabe no lab.</span>
      </h2>
      <p data-reveal class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        A MATHRICK é uma bancada de experimentos. Dali saem ferramentas de SaaS, utilitários pessoais, sites, hubs, dashboards, web apps e aplicativos mobile.
      </p>
    </div>

    <div class="grid gap-px border-t border-line bg-line md:grid-cols-2">
      {capabilities.map((c, i) => (
        <article data-reveal class="group bg-bg p-6 md:p-8">
          <Panel variant={c.variant} caption={`FIG. ${String(i + 1).padStart(2, "0")}`} />
          <div class="mt-6 flex items-baseline justify-between gap-4">
            <p class="hud-label text-accent-ink">{c.tag}</p>
            <p class="hud-label text-faint">{String(i + 1).padStart(2, "0")}</p>
          </div>
          <h3 class="mt-2 font-display text-2xl font-medium tracking-[-0.02em] text-ink-strong">{c.title}</h3>
          <p class="mt-2 max-w-md leading-relaxed text-muted">{c.text}</p>
        </article>
      ))}

      <article data-reveal class="flex flex-col justify-between bg-bg p-6 md:p-8">
        <div>
          <p class="hud-label text-faint">08</p>
          <h3 class="mt-2 font-display text-2xl font-medium tracking-[-0.02em] text-ink-strong">Tem uma ideia para o lab?</h3>
          <p class="mt-2 max-w-md leading-relaxed text-muted">
            Algumas das melhores ferramentas começam com uma frase: "e se existisse...?". Conte a sua e a gente vê se vira protótipo.
          </p>
        </div>
        <div class="mt-8">
          <Signature class="mb-4" />
          <div>
            <Btn href={site.whatsappMsg} external variant="outline" class="w-full sm:w-fit">Propor uma ideia</Btn>
          </div>
        </div>
      </article>
    </div>
  </Section>

  <!-- ================= 02 ASSINATURA ================= -->
  <Section id="assinatura" index="02" label="Assinatura" meta="Ideia · Protótipo · Produto">
    <div class="px-6 py-14 md:px-10 md:py-20">
      <p data-reveal class="hud-label text-faint">Autoria clara</p>
      <h2 data-reveal class="mt-4 max-w-3xl font-display text-4xl leading-[1.02] font-medium tracking-[-0.035em] text-ink-strong sm:text-5xl md:text-6xl">
        Tudo que sai daqui <span class="font-serif font-normal text-muted italic">leva o selo.</span>
      </h2>
      <p data-reveal class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        Cada ferramenta e cada site é assinado pela MATHRICK LAB. Uma marca única que liga projetos diferentes e mostra que existe uma pessoa cuidando de cada detalhe.
      </p>
      <div data-reveal class="mt-6"><Signature /></div>
    </div>

    <!-- ciclo do laboratório -->
    <ol class="grid gap-px border-t border-line bg-line sm:grid-cols-3">
      {stages.map((s, i) => (
        <li data-reveal class="relative bg-bg p-6 md:p-8">
          <p class="hud-label text-accent-ink">{s.key}</p>
          <p class="mt-3 font-display text-3xl leading-none font-semibold tracking-[-0.04em] text-ink-strong">{s.name}</p>
          <p class="mt-2 text-muted">{s.text}</p>
          {i < stages.length - 1 && <span aria-hidden="true" class="hud-label absolute top-1/2 -right-2 z-10 hidden -translate-y-1/2 bg-bg px-1 text-faint sm:block">→</span>}
        </li>
      ))}
    </ol>

    <div class="grid gap-px border-t border-line bg-line md:grid-cols-3">
      {signature.map((o) => (
        <div data-reveal class="bg-bg p-6 md:p-8">
          <span class="grid size-8 place-items-center border border-line-strong font-mono text-xs font-bold text-ink">{o.key}</span>
          <h3 class="mt-6 font-display text-xl font-medium tracking-[-0.02em] text-ink-strong">{o.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{o.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ================= 03 PROJETOS ================= -->
  <Section id="projetos" index="03" label="Projetos" meta="Assinados pelo lab">
    <div class="flex flex-col justify-between gap-6 px-6 py-14 sm:flex-row sm:items-end md:px-10 md:py-20">
      <div>
        <p data-reveal class="hud-label text-faint">Trabalhos no ar</p>
        <h2 data-reveal class="mt-4 max-w-3xl font-display text-4xl leading-[1.02] font-medium tracking-[-0.035em] text-ink-strong sm:text-5xl md:text-6xl">
          Feito <span class="font-serif font-normal text-muted italic">no lab.</span>
        </h2>
      </div>
      <div data-reveal><Btn href="/projetos" variant="outline">Todos os projetos</Btn></div>
    </div>

    <div class="grid gap-px border-t border-line bg-line md:grid-cols-3">
      {featured.map((p, i) => (
        <a
          data-reveal
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex min-h-[340px] flex-col justify-between bg-bg p-6 transition-colors hover:bg-invert-bg hover:text-invert-fg md:p-8"
        >
          <div class="flex items-center justify-between">
            <span class="hud-label opacity-60">{String(i + 1).padStart(2, "0")} · {p.type}</span>
            <span class="hud-label flex items-center gap-2"><span class="size-1.5 rounded-full" style={`background:${p.hue}`}></span>{p.status}</span>
          </div>
          <div>
            <p class="hud-label opacity-60">{p.kind}</p>
            <h3 class="mt-2 font-display text-4xl leading-none font-semibold tracking-[-0.04em] sm:text-5xl">
              {p.name[0]}<br /><span class="font-serif font-normal italic opacity-70">{p.name[1]}</span>
            </h3>
            <p class="hud-label mt-6 flex items-center gap-2 opacity-70 transition-transform group-hover:translate-x-1">Abrir projeto <span aria-hidden="true">↗</span></p>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <!-- ================= 04 CONTATO ================= -->
  <Section id="contato" index="04" label="Contato" meta="Resposta rápida">
    <div class="relative overflow-hidden px-6 py-20 text-center md:px-10 md:py-28">
      <p data-reveal class="hud-label text-faint">Bancada aberta · Novas ideias bem-vindas</p>
      <h2 data-reveal class="mx-auto mt-6 max-w-4xl font-display text-5xl leading-[0.98] font-medium tracking-[-0.04em] text-ink-strong sm:text-6xl md:text-7xl">
        Vamos testar <span class="font-serif font-normal text-muted italic">uma ideia?</span>
      </h2>
      <p data-reveal class="mx-auto mt-5 max-w-md text-lg leading-relaxed text-muted">
        Conte pelo WhatsApp ou por e-mail o que você quer construir. Se fizer sentido, vira protótipo no lab.
      </p>
      <div data-reveal class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Btn href={site.whatsappMsg} external>Falar no WhatsApp</Btn>
        <Btn href={`mailto:${site.email}`} variant="outline">{site.email}</Btn>
      </div>
    </div>
  </Section>

  <script>
    // Intro do wordmark: cada letra sobe com blur e estagger.
    const root = document.documentElement;
    const letters = Array.from(document.querySelectorAll<HTMLElement>(".wm-letter"));
    if (root.hasAttribute("data-intro") && letters.length) {
      letters.forEach((el, i) => {
        el.animate(
          [
            { opacity: 0, transform: "translateY(0.28em)", filter: "blur(14px)" },
            { opacity: 1, transform: "none", filter: "blur(0)" },
          ],
          { duration: 900, delay: 120 + i * 70, easing: "cubic-bezier(0.2,0.7,0.2,1)", fill: "backwards" },
        );
      });
      root.removeAttribute("data-intro");
    }
  </script>
</LabLayout>
