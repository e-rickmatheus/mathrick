---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MATHRICK — Laboratório Criativo & Design de Alta Conversão",
  description = "Estúdio e laboratório criativo desenvolvendo websites, produtos digitais, UI/UX e experiências interativas de alto impacto para marcas e startups."
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth bg-[#000005]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mathrick.com.br" />
    <meta name="theme-color" content="#000005" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#000005] text-white font-['Inter',sans-serif] antialiased selection:bg-white/20 selection:text-white min-h-screen flex flex-col justify-between overflow-x-hidden">
    <slot />
  </body>
</html>
